<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - siteFilm</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/siteFilm.styles.css" asp-append-version="true" />
</head>
<body class="bg-light">

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">

                <a class="navbar-brand fw-bold" asp-controller="Film" asp-action="Index">
                    🎬 SiteFilm
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">

                    <ul class="navbar-nav ms-auto">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Film" asp-action="Index">Liste des Films</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Film" asp-action="Create">Ajouter un Film</a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                Genres
                            </a>

                            <ul class="dropdown-menu dropdown-menu-dark">
                                @if (ViewBag.Genres is not null)
                                {
                                    foreach (string genre in ViewBag.Genres)
                                    {
                                        <li>
                                            <a class="dropdown-item"
                                                   asp-controller="Film"
                                                   asp-action="Index"
                                                   asp-route-genre="@genre">
                                                @genre
                                            </a>
                                        </li>
                                    }
                                }
                                else
                                {
                                    <li><span class="dropdown-item text-muted">Aucun genre disponible</span></li>
                                }
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Film" asp-action="APropos">Infos sur la liste</a>
                        </li>

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container py-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-light py-3 mt-4">
        <div class="container text-center small">
            &copy; 2026 - siteFilm -
            <a class="text-decoration-none text-info" asp-controller="Film" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
