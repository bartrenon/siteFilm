<div class="container mt-4">

    <h2 class="text-center text-primary mb-4">ℹ️ À propos des films</h2>

    @if (ViewBag.Message != null)
    {
        <div class="alert alert-info shadow-sm">
            @ViewBag.Message
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">

            <ul class="list-group list-group-flush">

                <li class="list-group-item d-flex justify-content-between">
                    <span class="fw-bold">Total de films :</span>
                    <span>@ViewData["TotalFilms"]</span>
                </li>

                <li class="list-group-item d-flex justify-content-between">
                    <span class="fw-bold">Genres différents :</span>
                    <span>@ViewBag.NbGenres</span>
                </li>

                <li class="list-group-item d-flex justify-content-between">
                    <span class="fw-bold">Film le plus ancien :</span>
                    <span>@ViewData["PlusAncien"]</span>
                </li>

                <li class="list-group-item d-flex justify-content-between">
                    <span class="fw-bold">Film le plus récent :</span>
                    <span>@ViewData["PlusRecent"]</span>
                </li>

            </ul>

        </div>
    </div>

    <div class="mt-4 text-center">
        <a asp-action="Index" class="btn btn-secondary">
            Retour à la liste
        </a>
    </div>

</div>

