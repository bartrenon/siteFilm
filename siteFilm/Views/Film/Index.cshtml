@model IEnumerable<Film>

@{
    ViewData["Title"] = "Liste de Films";
}

<!-- Toast Bootstrap -->
@if (TempData["success"] != null)
{
    <div class="toast position-fixed top-0 end-0 m-3" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header bg-success text-white">
            <strong class="me-auto">Succès</strong>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
        </div>
        <div class="toast-body">
            @TempData["success"]
        </div>
    </div>
}

<h2 class="text-center text-primary my-4">🎬 Liste des Films</h2>

@if (Model.Any())
{
    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Titre</th>
                <th>Genre</th>
                <th>Année</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var film in Model)
            {
                <tr>
                    <td>@film.Titre</td>
                    <td>@film.Genre</td>
                    <td>@film.Annee</td>

                    <td class="text-center">
                        <a asp-action="Details" asp-route-id="@film.Id" class="btn btn-info btn-sm me-2">
                            Voir détails
                        </a>

                        <form asp-action="Delete" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@film.Id" />
                            <button type="submit" class="btn btn-danger btn-sm">
                                Supprimer
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-center text-secondary">Aucun film trouvé.</p>
}

<p class="fw-bold mt-3">Nombre total : @Model.Count()</p>

<div class="btn-group mt-3">
    <a asp-action="APropos" class="btn btn-primary">À propos</a>
    <a asp-action="IndexTriCroissant" class="btn btn-secondary">Tri alphabétique</a>
    <a asp-action="Create" class="btn btn-success">Ajouter un film</a>
</div>

<script>
    const toastEl = document.querySelector('.toast');
    if (toastEl) {
        const toast = new bootstrap.Toast(toastEl);
        toast.show();
    }
</script>

 
