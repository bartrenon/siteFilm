<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

@model IEnumerable<Film>

@{
    ViewData["Title"] = "List de Film";
}

@if (TempData["success"] != null)
{
    <div class="toast" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header">
            <img src="..." class="rounded me-2" alt="...">
            <strong class="me-auto">Info</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body">
            @TempData["success"]
        </div>
    </div>
}


<h2 class="text-center text-primary"> Film - Liste </h2>

@if (Model.Any())
{
    <table>
        <thead>
            <tr>
                <th>Titre</th>
                <th>Genre </th>
                <th>Année</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Film film in Model)
            {
                <tr>
                    <td>@film.Titre</td>
                    <td>@film.Genre</td>
                    <td>@film.Annee</td>
                    <td>
                        <a asp-action="Details"  asp-route-id="@film.Id">Voir Détails</a>
                    </td>
                    <td>
                        <form asp-action="Delete" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@film.Id" />
                            <button type="submit" class="btn btn-danger">
                                Supprimer
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </table>
    }
else
    {
        <p class="text-center text-secondary">Aucun  trouvé.</p>
    }

    <p>Nombre total: @Model.Count()</p>
    
    <div class="btn-group">
        <a asp-action="APropos" class="btn btn-primary">Voir Détails</a>
        <a asp-action="IndexTriCroissant" class="btn btn-primary">Tri par ordre alfabétique</a>
        <a asp-action="Create" class="btn btn-primary">Ajouter un Film</a>
    </div>

    <script>
        const toastEl = document.querySelector('.toast');
        if (toastEl) {
            const toast = new bootstrap.Toast(toastEl);
            toast.show();
        }
    </script>
 
