@model siteFilm.Models.Film

<div class="container mt-4">

    <h2 class="text-center text-primary mb-4">🎬 Ajouter un film</h2>

    @if (TempData["Erreur"] != null)
    {
        <div class="alert alert-danger shadow-sm">
            @TempData["Erreur"]
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Create">

                <div class="mb-3">
                    <label asp-for="Titre" class="form-label fw-bold"></label>
                    <input asp-for="Titre" class="form-control" placeholder="Ex : Inception" />
                    <span asp-validation-for="Titre" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Genre" class="form-label fw-bold"></label>
                    <input asp-for="Genre" class="form-control" placeholder="Ex : Science-fiction" />
                    <span asp-validation-for="Genre" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Annee" class="form-label fw-bold"></label>
                    <input asp-for="Annee" class="form-control" placeholder="Ex : 2010" />
                    <span asp-validation-for="Annee" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">
                        Retour à la liste
                    </a>

                    <button type="submit" class="btn btn-success">
                        Ajouter le film
                    </button>
                </div>

            </form>

        </div>
    </div>

</div>

